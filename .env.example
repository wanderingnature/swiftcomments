# The environment the pipeline reads. Copy this file to .env in the repository
# root and fill it in. Nothing else in the nine steps reads the environment.

# ---- The model server, for the four model steps: stance, the citation
# ---- afterstep, substance, the roster. Any server speaking the OpenAI chat API,
# ---- run locally. docs/model-server.md says how, with LM Studio, ollama or vLLM.

# The base URL up to and including /v1, for example http://127.0.0.1:1234/v1
LLM_BASE_URL=

# The API key, sent as a Bearer header when set. Leave it empty for a server
# that needs none; LM Studio and ollama need none.
LLM_API_KEY=

# The model, Qwen3.8-27B, under the name your server gives it: qwen/qwen3.8-27b
# in LM Studio, qwen3.8:27b in ollama, Qwen/Qwen3.8-27B in vLLM. Every row a
# model step writes is stamped with this name.
LLM_MODEL=

# ---- The MinerU server, for the OCR of the scanned attachments in step 8.
# ---- docs/mineru.md says how to install and run it.

# MinerU's default port is 8000. Run it on any port you like and put that port
# here, for example http://127.0.0.1:8000
MINERU_BASE_URL=

# Set only if you started the MinerU server with --api-key.
MINERU_API_KEY=
