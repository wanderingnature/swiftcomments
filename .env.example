# The environment the pipeline reads. Copy this file to .env in the repository
# root and fill it in. Nothing else in the nine steps reads the environment.

# ---- The model server, for the three model steps: stance, substance, the
# ---- roster. Any server speaking the OpenAI chat API, run locally or an API.
# ---- docs/model-server.md says how, with OpenRouter, LM Studio, ollama or vLLM.

# The base URL up to and including /v1, for example http://127.0.0.1:1234/v1
# for a local server, https://openrouter.ai/api/v1 or https://api.together.ai/v1.
# The client adds /chat/completions; a value that already ends in it is taken
# as its base.
LLM_BASE_URL=

# The API key, sent as a Bearer header when set. Leave it empty for a server
# that needs none; LM Studio and ollama need none.
LLM_API_KEY=

# Set to 1 for a provider that serves the model only as a stream (Together does,
# and says so on the first call, after which the client streams on its own).
LLM_STREAM=

# On OpenRouter, the one provider every call is pinned to, with fallbacks off,
# so the rows come from the weights and the prices you chose: alibaba is the
# provider our runs use. Leave it empty for a local server.
LLM_PROVIDER=

# A second server, named, for a command run with SERVER=<NAME> (make) or
# LLM_SERVER=<NAME>: the same five variables with the name in the middle. The
# plain set above stays what every command uses without SERVER=. For example a
# local LM Studio beside an API, for the comments the API's provider refuses:
#   make stance REFUSED_IN=<run> SERVER=LOCAL
LLM_LOCAL_BASE_URL=
LLM_LOCAL_API_KEY=
LLM_LOCAL_MODEL=
LLM_LOCAL_PROVIDER=
LLM_LOCAL_STREAM=

# The model, under the name your server gives it. Qwen3.8-27B is the model our
# published run used (qwen/qwen3.8-27b in LM Studio, qwen3.8:27b in ollama,
# Qwen/Qwen3.8-27B in vLLM); Qwen3.8-Flash (qwen/qwen3.8-flash) is the model this
# repository's runs use, through an API, for cost. docs/model-server.md says what
# each needs and what another choice means. Every row a model step writes is
# stamped with this name.
LLM_MODEL=

# ---- The MinerU server, for the OCR of the scanned attachments in step 8.
# ---- docs/mineru.md says how to install and run it.

# MinerU's default port is 8000. Run it on any port you like and put that port
# here, for example http://127.0.0.1:8000
MINERU_BASE_URL=

# Set only if you started the MinerU server with --api-key.
MINERU_API_KEY=
